{
  "expo": {
    "name": "PISTON GARAGE",
    "slug": "piston-garage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pistongarage",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.pistongarage.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Araç fotoğrafı ve fatura eklemek için galerine erişim gerekiyor.",
        "NSCameraUsageDescription": "Araç fotoğrafı ve fiş çekmek için kameraya erişim gerekiyor.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17191D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pistongarage.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17191D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#B6F000"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Araç fotoğrafı ve fatura eklemek için galerine erişim gerekiyor.",
          "cameraPermission": "Araç fotoğrafı ve fiş çekmek için kameraya erişim gerekiyor."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#17191D",
    "extra": {
      "eas": {
        "projectId": "34bd53e1-93c3-47a6-8c2b-d0d8e4e17335"
      }
    },
    "owner": "berat53"
  }
}
